# Anthropic API Key
ANTHROPIC_API_KEY=your_api_key_here

# Langfuse (optional - tracing; enabled automatically when these are set)
# Create keys at https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
# LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
# LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
# LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith (optional - for tracing and monitoring)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=text2sql-deepagent

# Tavily API (optional - for web search capabilities)
TAVILY_API_KEY=your_tavily_api_key_here
